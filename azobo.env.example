# Microsoft Entra app registration that performs the OBO exchange (the "resource"
# app the MCP client's token is audienced to). NOT a secret on its own.
AZOBO_TENANT_ID=00000000-0000-0000-0000-000000000000
AZOBO_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Confidential-client certificate (the OBO broker key). KEEP THE PRIVATE KEY SECRET.
AZOBO_CERT_THUMBPRINT=AABBCCDDEEFF00112233445566778899AABBCCDD
AZOBO_CERT_KEY=/etc/azobo/obo.key
AZOBO_CERT_PUB=/etc/azobo/obo.crt
# Optional default subscription when a command doesn't pass --subscription.
AZOBO_DEFAULT_SUBSCRIPTION=
# Public FQDN the MCP server is reached at (DNS-rebind allow-list).
AZOBO_PUBLIC_HOST=azobo.example.com
# --- Security ---
# Verify the incoming bearer (signature via tenant JWKS, audience, issuer, expiry)
# before trusting any claim. Leave ON. Off = trust unsigned JWT payloads (lab only).
AZOBO_VALIDATE_TOKENS=true
# Expected token audience (optional). The app's client-id and api://<client-id>
# are accepted automatically; set this only if your tokens carry a different aud.
AZOBO_AUDIENCE=
# Caller authorization beyond aud/iss/exp — SET THESE IN PROD (multi-client tenants):
#   required delegated scope (token's scp must contain it):
AZOBO_REQUIRED_SCOPE=user_impersonation
#   allow-list of client app IDs permitted to call (token azp/appid); empty = any:
AZOBO_ALLOWED_CLIENTS=
# Safe-by-default: read-only ON. Forces Graph GET-only and refuses mutating `az`
# verbs (incl. rest/invoke non-GET). Set false to allow writes (per-user RBAC is then
# the boundary). Defense-in-depth, not a hard policy boundary — see README.
AZOBO_READONLY=true
# Egress/exfil control: comma list of `az` commands to disable outright. For
# less-trusted callers, removing the rawest token/SSRF primitives is prudent:
AZOBO_DENY_COMMANDS=rest,account get-access-token
# Optional concurrency cap (0 = unlimited; MemoryMax in the unit is the backstop).
AZOBO_MAX_CONCURRENCY=0

# --- Operational knobs (optional; defaults shown) ---
AZOBO_TIMEOUT=150                 # per-command ceiling (seconds); long ops -> use --no-wait
AZOBO_MAX_OUTPUT_CHARS=100000     # cap on RETURNED output (~25k tokens)
# Hard cap on bytes CAPTURED from one command (stdout+stderr) — the child is killed
# the instant it exceeds this, so a runaway download/response can't eat RAM. Pair
# with the unit's LimitFSIZE/MemoryMax for host-level protection.
AZOBO_MAX_CAPTURE_BYTES=20971520  # 20 MB
# Full captured output is retained IN MEMORY ONLY (never on disk), paged via
# read_output. Bounded by entry count, total bytes, and TTL; evicted oldest-first.
AZOBO_OUTPUT_MAX_ENTRIES=300
AZOBO_OUTPUT_MAX_BYTES=104857600  # 100 MB total across all retained outputs
AZOBO_OUTPUT_TTL_SECONDS=1800
# Audit log (metadata only: who/tool/cmd/rc — NOT command output). On the writable
# path the sandboxed unit allows; created 0600.
AZOBO_AUDIT_LOG=/var/lib/azobo/audit.log

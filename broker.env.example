# ===========================================================================
# BROKER env — /etc/azobo/broker.env (the OBO credential broker only). This is
# the ONLY place the cert is referenced. Lock it down:
#   chown azobo-broker:azobo /etc/azobo/broker.env && chmod 640 /etc/azobo/broker.env
# and the key itself:
#   chown azobo-broker:azobo /etc/azobo/obo.key   && chmod 600 /etc/azobo/obo.key
# Nothing on the `az` side can read either.
# ===========================================================================

AZOBO_TENANT_ID=00000000-0000-0000-0000-000000000000
AZOBO_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Confidential-client certificate (the OBO broker key). KEEP THE PRIVATE KEY SECRET.
AZOBO_CERT_THUMBPRINT=AABBCCDDEEFF00112233445566778899AABBCCDD
AZOBO_CERT_KEY=/etc/azobo/obo.key
AZOBO_CERT_PUB=/etc/azobo/obo.crt
# Local socket the broker listens on (must match the server's AZOBO_BROKER_SOCKET).
AZOBO_BROKER_SOCKET=/run/azobo/broker.sock
# How long a registered session (assertion handle) is mintable before it must be
# re-registered. Slightly longer than AZOBO_TIMEOUT is plenty.
AZOBO_SESSION_TTL=300

# The broker validates assertions ITSELF at register (it's the credential boundary,
# so it doesn't trust the caller). Mirror the server's policy here:
AZOBO_VALIDATE_TOKENS=true
AZOBO_AUDIENCE=
AZOBO_REQUIRED_SCOPE=user_impersonation
AZOBO_ALLOWED_CLIENTS=

[Unit]
Description=azobo MCP - per-user OBO Azure CLI + Microsoft Graph
After=network-online.target
Wants=network-online.target

[Service]
# Dedicated unprivileged user — NEVER run this as root. Create it once:
#   useradd --system --no-create-home --shell /usr/sbin/nologin azobo
# and make the OBO key readable only by it:
#   chown azobo:azobo /etc/azobo/obo.key && chmod 600 /etc/azobo/obo.key
#   install -d -o azobo -g azobo -m 700 /var/lib/azobo   # audit log dir
User=azobo
Group=azobo
EnvironmentFile=/etc/azobo/azobo.env
ExecStart=/opt/azobo/venv/bin/python /opt/azobo/server.py
Restart=always
RestartSec=3

# --- sandbox / least privilege ---------------------------------------------
NoNewPrivileges=yes
UMask=0077
# Whole FS read-only except the audit-log dir; key under /etc/azobo stays RO.
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/azobo
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Belt-and-suspenders: stop the wrapped Azure CLI auto-installing/running
# extension code, and silence telemetry.
Environment=AZURE_CORE_DISABLE_DYNAMIC_INSTALL=yes
Environment=AZURE_CORE_COLLECT_TELEMETRY=no

[Install]
WantedBy=multi-user.target
